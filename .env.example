# ============================================================
# CPQ Platform — Environment Configuration Template
# ============================================================
# Copy this file to backend/.env and fill in your own values.
# NEVER commit backend/.env to version control.
#
# Usage:
#   cp .env.example backend/.env
#   nano backend/.env   # fill in real values
# ============================================================

# ─── Application ────────────────────────────────────────────
# Environment tag. Use LOCAL_DEV for local development.
# Allowed values: LOCAL_DEV | STAGING | PRODUCTION
ENVIRONMENT=LOCAL_DEV

# ─── Database ───────────────────────────────────────────────
# Full async PostgreSQL connection string (asyncpg driver).
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+asyncpg://postgres:your_password_here@localhost:5432/cpq_db

# ─── JWT Authentication ─────────────────────────────────────
# REQUIRED: Generate a strong random secret before deployment.
# Generate one with:  openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_secret_generated_with_openssl_rand_hex_32

# JWT signing algorithm (HS256 is recommended for symmetric HMAC)
JWT_ALGORITHM=HS256

# How long access tokens remain valid (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# How long refresh tokens remain valid (days)
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── Google Gemini AI (optional) ────────────────────────────
# Required only if enabling the AI Copilot / Quote Explanation feature.
GEMINI_API_KEY=

# ─── Salesforce Integration (optional) ──────────────────────
# Required only when enabling the Salesforce integration module.
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/salesforce/callback

# --- Quote assistant (LLM orchestrator). LLM_PROVIDER=none disables it. ---
# gemini: uses GEMINI_API_KEY / GEMINI_MODEL below.
# openai_compatible: any /chat/completions server, e.g. Ollama at http://localhost:11434/v1
LLM_PROVIDER=none
LLM_MODEL=
LLM_BASE_URL=
