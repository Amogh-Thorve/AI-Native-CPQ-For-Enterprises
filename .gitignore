# ============================================================
# CPQ Platform - Git Ignore
# ============================================================

# ─── Environment & Secrets ──────────────────────────────────
# NEVER commit .env files that contain real credentials
.env
.env.*
!.env.example
backend/.env
frontend/.env
frontend/.env.local
frontend/.env.development
frontend/.env.production

# ─── Python ─────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
.Python
*.egg-info/
*.egg
dist/
build/
.venv/
venv/
env/
.python-version

# ─── Database Files ─────────────────────────────────────────
# Do NOT commit database files — use Alembic migrations instead
*.sqlite3
*.db
*.db-shm
*.db-wal
# PostgreSQL data directories
pg_data/
postgres_data/
data/postgres/
pgdata/

# ─── Alembic ────────────────────────────────────────────────
# Compiled artefacts only — migration .py files SHOULD be tracked
backend/alembic/versions/*.pyc

# ─── Next.js / Node ─────────────────────────────────────────
frontend/.next/
frontend/out/
frontend/node_modules/
node_modules/
.npm
.yarn-integrity
*.tsbuildinfo
next-env.d.ts

# ─── Uploaded Files ─────────────────────────────────────────
# Runtime uploads must not be committed
backend/static/documents/
uploads/
*.xlsx
*.xls
*.pdf

# ─── Logs ───────────────────────────────────────────────────
*.log
logs/
*.log.*

# ─── Test Artefacts ─────────────────────────────────────────
.pytest_cache/
htmlcov/
.coverage
coverage.xml
*.coveragerc

# ─── IDE & Editor ───────────────────────────────────────────
.vscode/
.idea/
*.iml
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo

# ─── OS ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ─── Docker ─────────────────────────────────────────────────
# Commit docker-compose.yml and Dockerfiles — not runtime data
docker/data/
docker/postgres-data/
backend/storage/
