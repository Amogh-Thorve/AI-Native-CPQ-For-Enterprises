# ============================================================
# CPQ Platform - Environment Variable Template
# ============================================================
# Copy this file to .env and fill in real values.

DATABASE_URL=postgresql+asyncpg://cpq_user:cpq_password@localhost:5432/cpq_db
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
GEMINI_API_KEY=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/salesforce/callback

# --- Outbound email (proposal delivery). Leave SMTP_HOST empty to disable sending. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# --- AI copilot (optional; without a key, data-driven fallbacks are used) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Salesforce OAuth (optional; token connect works without these) ---
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_LOGIN_URL=https://login.salesforce.com
SALESFORCE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/salesforce/callback
FRONTEND_URL=http://localhost:3000

# --- Proposal branding ---
COMPANY_NAME=Your Company
COMPANY_ADDRESS=
COMPANY_EMAIL=
